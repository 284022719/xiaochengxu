.img-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 14rpx 0 16rpx;
}

.thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
}

.owner-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.owner-actions button {
  border-radius: 999rpx;
  border: 1rpx solid #dbe3ef;
  background: #f8fbff;
  color: #334155;
}

.owner-actions button[type="warn"] {
  background: #fff1f2;
  color: #dc2626;
  border: 1rpx solid #fecdd3;
}

.card-done {
  opacity: 0.7;
}

.publisher-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.publisher-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #eaeaea;
}

.placeholder-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666;
  font-size: 20rpx;
}

.publisher-name {
  color: #4b5563;
  font-size: 24rpx;
}
