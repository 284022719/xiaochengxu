.input,
.textarea {
  border: 1rpx solid #dbe3ef;
  border-radius: 12rpx;
  margin-bottom: 18rpx;
  padding: 18rpx;
  font-size: 28rpx;
  background: #f9fbff;
}

.textarea {
  min-height: 180rpx;
}

.img-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 10rpx 0 24rpx;
}

.thumb-wrap {
  position: relative;
}

.thumb,
.add {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #eef3fb;
}

.add {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4b5563;
  border: 1rpx dashed #bfd3f5;
}

.del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #ff4d4f;
  color: #fff;
  text-align: center;
  line-height: 36rpx;
}
