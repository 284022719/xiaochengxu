page {
  background: #f6f8fb;
  color: #1f2937;
  font-size: 28rpx;
}

.container {
  padding: 24rpx 24rpx 34rpx;
}

.card {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 24rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 8rpx 28rpx rgba(31, 41, 55, 0.08);
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
  color: #111827;
}

.row {
  margin-bottom: 10rpx;
  color: #374151;
  line-height: 1.6;
}

.muted {
  color: #9ca3af;
}

.btn-primary {
  background: #2563eb;
  color: #fff;
  border-radius: 999rpx;
  border: none;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin: 20rpx 0;
  color: #111827;
}

button {
  border-radius: 12rpx;
  border: 1rpx solid #dbe3ef;
  background: #ffffff;
  color: #334155;
}

button::after {
  border: none;
}